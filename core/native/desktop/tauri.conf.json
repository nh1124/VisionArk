{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionArk",
  "version": "0.1.0",
  "identifier": "com.visionark.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VisionArk",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "console",
        "title": "Daemon Console",
        "width": 800,
        "height": 500,
        "resizable": true,
        "visible": false
      },
      {
        "label": "fileviewer",
        "title": "File Viewer",
        "width": 900,
        "height": 650,
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": [
      "binaries/visionark-daemon"
    ]
  }
}
