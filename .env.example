# VisionArk Configuration

# Environment Settings
ATMOS_ENV=dev
DEBUG=true

# Database Configuration
POSTGRES_USER=atmos
POSTGRES_PASSWORD=atmos_secret
POSTGRES_DB=atmos
DATABASE_URL=postgresql://atmos:atmos_secret@localhost:5432/atmos

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=your_api_key_here

# Service URLs (Standard Ports)
LBS_SERVICE_URL=http://host.docker.internal:8001/api/lbs
KNOWLEDGE_CORE_URL=http://host.docker.internal:8200

# Security
ATMOS_SERVICE_KEY=ARK-SECURE-SERVICE-KEY-2025
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256

# Communication Ports
BACKEND_PORT=8000
VA_HOST_PORT=8000
FRONTEND_PORT=3000
VA_HOST_FRONTEND_PORT=3000
